rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/devices/{deviceId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() < 4096
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isOwner(userId);

      match /scheduledReminders/{reminderId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'id', 'kind', 'dueAt', 'active', 'repeatDays', 'localTime',
            'timeZone', 'sentAt', 'updatedAt', 'claimedAt'
          ])
          && request.resource.data.id is string
          && request.resource.data.kind in ['reminder', 'focus_alarm']
          && (request.resource.data.dueAt is int || request.resource.data.dueAt is float)
          && request.resource.data.active is bool
          && request.resource.data.sentAt == null
          && request.resource.data.updatedAt is timestamp
          && (!('repeatDays' in request.resource.data)
            || request.resource.data.repeatDays is list)
          && (!('localTime' in request.resource.data)
            || request.resource.data.localTime is string)
          && (!('timeZone' in request.resource.data)
            || request.resource.data.timeZone is string);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
